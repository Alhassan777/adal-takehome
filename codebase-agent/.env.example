REPO_PATH=/path/to/your/repo
CODEBASE_AGENT_DEV_LOG=0
OPENAI_API_KEY=sk-...

# Execution mode: adaptive (default, structured tool calls) or rlm (REPL + sub-models)
EXECUTION_MODE=adaptive

# OpenAI model for root agent calls
OPENAI_MODEL=gpt-4o

# OpenAI model for sub-model workers and critic calls
OPENAI_SUB_MODEL=gpt-4o-mini

# Sandbox mode for RLM: local (fast, dev) or docker (isolated, prod)
RLM_SANDBOX=local
