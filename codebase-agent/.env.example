# Host path to the repo you want to analyze.
# Docker: set to the host path that gets mounted at /workspace/repo inside the container.
# Local: set to the absolute path on your machine.
REPO_PATH=/path/to/your/repo
CODEBASE_AGENT_DEV_LOG=0
OPENAI_API_KEY=sk-...

# Execution mode: adaptive (default, structured tool calls) or rlm (REPL + sub-models)
EXECUTION_MODE=adaptive

# OpenAI model for root agent calls
OPENAI_MODEL=gpt-4o

# OpenAI model for sub-model workers and critic calls
OPENAI_SUB_MODEL=gpt-4o-mini

# Model for LLM-enhanced file summaries (defaults to gpt-4o-mini)
SUMMARY_LLM_MODEL=gpt-4o-mini

# Number of files per LLM batch when generating summaries (default: 5)
SUMMARY_BATCH_SIZE=5

# Sandbox mode for RLM: local (fast, dev) or docker (isolated, prod)
RLM_SANDBOX=local
